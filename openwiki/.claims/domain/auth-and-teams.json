    {
      "id": "claim_4d5faf2de0154821b1e9b55246106b08",
      "statement": "OAuth login is initiated by navigating to ${apiUrl}/auth/oauth/authorize/${provider}?noauthchallenge. The oauthUrl() helper in src/oauth-url.ts constructs this URL from environment.apiUrl.",
