    {
      "id": "claim_7d96fe10a9da42928462ec3a6e1b576b",
      "statement": "The email verification page at /auth/verify reads email, token, and error from URL search params. Missing params show 'Invalid link'; an error param shows 'Verification failed'; valid params call auth.verify(email, token) which returns a URL that the browser redirects to via window.location.href.",
      "evidence": [
        {
          "resource": "repo://src/pages/auth/verify/Verify.tsx#L5-L20",
          "version": "repo-lines-v1:sha256:370890e800ee8d71abb919de361a29bfa490da91b21683b4546d4606c78dbc2f:"
        }
