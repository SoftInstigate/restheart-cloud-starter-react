    {
      "id": "claim_0be93dd528494dd0a39612222de8ebf1",
      "statement": "When invitation.isNewUser === true, the invitation page shows a password form and calls auth.activate({ email, token, password }) which both creates the account and accepts the invitation, then navigates to /.",
