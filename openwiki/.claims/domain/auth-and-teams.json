    {
      "id": "claim_3f5501b4115943059650104724babb20",
      "statement": "Password reset is a two-step flow: ForgotPassword sends auth.forgotPassword(email) and always shows the same confirmation (the API returns 202 regardless of whether the email exists to avoid leaking registered addresses). ResetPassword reads email and token from query params, calls auth.resetPassword({ email, token, password }), and navigates to / on success.",
      "evidence": [
        {
          "resource": "repo://src/pages/auth/forgot-password/ForgotPassword.tsx#L22-L28",
