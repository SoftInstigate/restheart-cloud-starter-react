    {
      "id": "claim_5e8df377fdf94868b0e8a9491dfb351b",
      "statement": "The signup form auto-generates a team name as {firstName}'s Team (falling back to {emailPrefix}'s Team) and passes it to auth.register({ teamName, firstName, lastName, email, password }). On 409 it shows 'An account with this email already exists.'",
      "evidence": [
        {
          "resource": "repo://src/pages/auth/signup/Signup.tsx#L32-L42",
